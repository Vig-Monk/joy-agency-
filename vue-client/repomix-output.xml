                :class="{ error: fieldError('message') }"
              ></textarea>
            </div>

            <button class="fsub" type="submit" :disabled="loading">
              <span v-if="loading">Sending…</span>
              <span v-else>Send Inquiry →</span>
            </button>
          </form>

          <!-- WhatsApp alternative -->
