/* ─────────────────────────────────────────────────────────────
   CONTACT
───────────────────────────────────────────────────────────── */
.contact-wrap { background: var(--white); }
.contact-inner {
  max-width: 1300px;
  margin: 0 auto;
  padding: 6rem 2.5rem;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4rem;
  align-items: start;
}
.contact-text .sec-title { margin-bottom: 1rem; }
.contact-text p { color: var(--muted); font-size: 0.95rem; line-height: 1.75; max-width: 340px; }
.cdetails { margin-top: 2rem; display: flex; flex-direction: column; gap: 0.8rem; }
