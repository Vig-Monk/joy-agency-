nav a:hover { color: #1A1A1A; }

.nav-btn {
  background: #1A1A1A !important;
  color: #ffffff !important;
  padding: 0.5rem 1.2rem !important;
  border-radius: 100px !important;
  font-weight: 600 !important;
  font-size: 0.85rem !important;
