  border-radius: 10px;
  display: flex; align-items: center; justify-content: center;
  font-size: 1rem;
}
.ci-t { background: rgba(27,191,191,0.1); }
.ci-o { background: rgba(247,148,29,0.1); }
.ci-p { background: rgba(233,30,140,0.1); }

/* Form */
.cform {
  background: var(--bg);
  border-radius: var(--r);
  padding: 2rem;
  box-shadow: 0 4px 24px rgba(0,0,0,0.05), inset 0 1px 0 rgba(255,255,255,0.8);
}
.frow {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.75rem;
  margin-bottom: 0.75rem;
}
.ff { display: flex; flex-direction: column; gap: 0.3rem; }
.ff label { font-size: 0.75rem; font-weight: 600; color: var(--muted); letter-spacing: 0.5px; }
.ff input,
.ff select,
.ff textarea {
  background: var(--white);
  border: 1.5px solid rgba(0,0,0,0.08);
  border-radius: 12px;
  padding: 0.7rem 0.9rem;
  font-size: 0.9rem;
  font-family: 'DM Sans', sans-serif;
  color: var(--ink);
  outline: none;
  transition: border-color 0.2s, box-shadow 0.2s;
}
.ff input:focus,
.ff select:focus,
.ff textarea:focus {
  border-color: var(--teal);
  box-shadow: 0 0 0 3px rgba(27,191,191,0.1);
}
.ff input.error,
.ff textarea.error {
  border-color: var(--pink);
  box-shadow: 0 0 0 3px rgba(233,30,140,0.1);
}
.ff textarea { resize: vertical; min-height: 90px; }
.fsub {
  width: 100%;
  margin-top: 0.75rem;
  padding: 0.85rem;
  border: none;
  border-radius: 100px;
  cursor: pointer;
  background: var(--ink);
  color: #fff;
  font-size: 0.95rem;
  font-weight: 600;
  font-family: 'DM Sans', sans-serif;
  box-shadow: 0 6px 20px rgba(0,0,0,0.18);
  transition: background 0.2s, transform 0.2s, opacity 0.2s;
}
.fsub:hover { background: #333; transform: translateY(-2px); }
.fsub:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }

/* Form validation errors */
.form-errors {
  background: rgba(233,30,140,0.07);
  border: 1px solid rgba(233,30,140,0.2);
  border-radius: 12px;
  padding: 0.8rem 1rem;
  margin-bottom: 1rem;
}
.form-errors p { font-size: 0.8rem; color: var(--pink); margin-bottom: 0.2rem; }
.form-errors p:last-child { margin-bottom: 0; }

/* Success state */
.form-success {
  text-align: center;
  padding: 2rem 1rem;
}
.success-icon { font-size: 2.5rem; margin-bottom: 0.5rem; }
.form-success h3 {
  font-family: 'DM Serif Display', serif;
  font-size: 1.5rem;
  margin-bottom: 0.5rem;
}
.form-success p { color: var(--muted); font-size: 0.9rem; }

/* WhatsApp alternative link */
.form-alt-text {
  text-align: center;
  font-size: 0.8rem;
  color: var(--muted);
  margin-top: 0.75rem;
}
.form-alt-text a { color: var(--teal); font-weight: 600; text-decoration: none; }
.form-alt-text a:hover { text-decoration: underline; }

/* ─────────────────────────────────────────────────────────────
   FOOTER
───────────────────────────────────────────────────────────── */
footer {
  background: var(--bg);
  border-top: 1px solid rgba(0,0,0,0.06);
  padding: 2rem 2.5rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 0.82rem;
  color: var(--muted);
}
.footer-logo { height: 40px; }

/* ─────────────────────────────────────────────────────────────
   FLOATING WHATSAPP BUTTON
───────────────────────────────────────────────────────────── */
.wa-float {
  position: fixed;
  bottom: 1.8rem;
  right: 1.8rem;
  z-index: 999;
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background: #25D366;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 16px rgba(37,211,102,0.45);
  transition: transform 0.2s, box-shadow 0.2s;
  text-decoration: none;
}
.wa-float:hover {
  transform: translateY(-3px) scale(1.06);
  box-shadow: 0 8px 24px rgba(37,211,102,0.55);
}

/* ─────────────────────────────────────────────────────────────
   SCROLL REVEAL ANIMATIONS
   .reveal-section wraps each page section.
   .reveal-item is each card / block inside it.
   When IntersectionObserver fires, .is-visible is added to
   the section and all .reveal-item children animate in.
───────────────────────────────────────────────────────────── */
.reveal-item {
  opacity: 0;
  transform: translateY(28px);
  transition:
    opacity 0.55s ease calc(var(--delay, 0s)),
    transform 0.55s ease calc(var(--delay, 0s));
}

.reveal-section.is-visible .reveal-item {
  opacity: 1;
  transform: translateY(0);
}

/* ─────────────────────────────────────────────────────────────
   HERO KEYFRAME
───────────────────────────────────────────────────────────── */
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(20px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ─────────────────────────────────────────────────────────────
   RESPONSIVE
───────────────────────────────────────────────────────────── */
@media (max-width: 960px) {
  .hero-section { padding: 0 1.5rem; min-height: auto; }
  .hero { grid-template-columns: 1fr; padding-top: 6rem; padding-bottom: 3rem; gap: 2rem; }
  .hero-bento { display: none; }
  .bento { grid-template-columns: 1fr 1fr; }
  .span2 { grid-column: span 2; }
  .why-inner, .contact-inner { grid-template-columns: 1fr; gap: 2rem; }
  .prow { grid-template-columns: 1fr 1fr; }
  .test-grid { grid-template-columns: 1fr; }
  nav ul { display: none; }
}

@media (max-width: 600px) {
  .bento { grid-template-columns: 1fr; }
  .span2 { grid-column: span 1; }
  .frow { grid-template-columns: 1fr; }
  .prow { grid-template-columns: 1fr; }
  footer { flex-direction: column; gap: 0.5rem; text-align: center; }
  .wrap { padding: 4rem 1.5rem; }
  .wa-float { bottom: 1.2rem; right: 1.2rem; width: 50px; height: 50px; }
}
