.bc-desc { font-size: 0.83rem; color: var(--muted); line-height: 1.65; }
.bc-dark .bc-desc { color: rgba(255,255,255,0.55); }
.bc-num {
  font-family: 'DM Serif Display', serif;
  font-size: 4rem;
  line-height: 1;
