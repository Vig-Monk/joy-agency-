  -webkit-backdrop-filter: blur(16px);
  border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  transition: box-shadow 0.3s;
}
nav.scrolled { box-shadow: 0 2px 16px rgba(0, 0, 0, 0.08); }

nav ul {
  list-style: none;
  display: flex;
  gap: 0.5rem;
  align-items: center;
}

nav a {
  text-decoration: none;
