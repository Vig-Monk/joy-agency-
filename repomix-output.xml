                v-if="form.photo_url || photoPreview"
                type="button"
                class="remove-photo-btn"
                @click.stop="removePhoto"
              >Remove photo</button>
            </div>

            <div class="mfield">
              <label>Full Name <span class="req">*</span></label>
              <input v-model="form.name" placeholder="e.g. Jane Wanjiru" required />
            </div>
