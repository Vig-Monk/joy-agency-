      <div class="fw-footer reveal-item" style="--delay:0.5s">
        <RouterLink to="/workers" class="fw-cta-btn">See All Workers →</RouterLink>
        <p>{{ totalCount > 4 ? `${totalCount - 4} more workers available` : 'New workers added regularly' }}</p>
