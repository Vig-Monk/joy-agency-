    0 20px 48px rgba(0, 0, 0, 0.05),
    inset 0 1px 0 rgba(255, 255, 255, 0.9);
  transition: transform 0.25s, box-shadow 0.25s;
}
.clay:hover {
  transform: translateY(-4px) scale(1.01);
  box-shadow:
    0 4px 8px rgba(0, 0, 0, 0.05),
    0 16px 40px rgba(0, 0, 0, 0.10),
    0 32px 64px rgba(0, 0, 0, 0.07),
    inset 0 1px 0 rgba(255, 255, 255, 0.9);
}

/* ─────────────────────────────────────────────────────────────
   HERO
───────────────────────────────────────────────────────────── */
.hero-section {
  min-height: 100vh;
  display: flex;
  align-items: center;
  padding: 0 2.5rem;
  background: #F4F2EE;
}
.hero {
  width: 100%;
  max-width: 1300px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3rem;
  align-items: center;
  padding: 7rem 0 4rem;
}

.hero-pill {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  background: #ffffff;
  border: 1.5px solid rgba(27, 191, 191, 0.3);
  padding: 0.4rem 0.9rem;
  border-radius: 100px;
  font-size: 0.78rem;
  font-weight: 600;
  color: #1BBFBF;
  margin-bottom: 1.5rem;
  box-shadow: 0 2px 8px rgba(27, 191, 191, 0.12);
}
.pill-dot {
  width: 6px; height: 6px;
  border-radius: 50%;
  background: #1BBFBF;
}

.hero h1 {
  font-family: 'DM Serif Display', serif;
  font-size: clamp(2.8rem, 4.5vw, 4.2rem);
  line-height: 1.1;
  letter-spacing: -1px;
  color: #1A1A1A;
  animation: fadeUp 0.7s ease both;
}
.hero h1 em { font-style: italic; color: #1BBFBF; }

.hero-sub {
  margin-top: 1.2rem;
  font-size: 1rem;
  line-height: 1.75;
  color: #6B6B6B;
  max-width: 420px;
  animation: fadeUp 0.7s 0.15s ease both;
}

.hero-actions {
  margin-top: 2rem;
  display: flex;
  gap: 0.8rem;
  flex-wrap: wrap;
  animation: fadeUp 0.7s 0.3s ease both;
}

.hero-trust {
  margin-top: 1.2rem;
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  font-size: 0.8rem;
  font-weight: 600;
  color: #6B6B6B;
}
.hero-trust span { display: flex; align-items: center; gap: 0.3rem; }

/* ─────────────────────────────────────────────────────────────
   HERO BENTO
───────────────────────────────────────────────────────────── */
.hero-bento {
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: auto auto auto;
  gap: 1rem;
  align-self: center;
  animation: fadeUp 0.7s 0.2s ease both;
  will-change: transform;
}
.hcard {
  border-radius: var(--r);
  position: relative;
  overflow: hidden;
  box-shadow: 0 4px 16px rgba(0,0,0,0.06), 0 12px 32px rgba(0,0,0,0.06), inset 0 1px 0 rgba(255,255,255,0.9);
  transition: transform 0.25s, box-shadow 0.25s;
  will-change: transform;
}
.hcard:hover { transform: translateY(-4px); }
.hcard-img { width: 100%; height: 150px; object-fit: cover; object-position: center top; display: block; }
.hcard-body { padding: 0.9rem 1.1rem 1.1rem; }
.hc-dark { background: #1A1A1A; padding: 1.4rem; }
.hc-teal { background: linear-gradient(135deg, #e4f9f9, #f5ffff); }
.hc-orange { background: linear-gradient(135deg, #fff0dc, #fffcf7); }
.hc-wide { grid-column: span 2; }
.hc-wide .hcard-img { height: 170px; }
.hc-stat { padding: 1.4rem; display: flex; flex-direction: column; justify-content: center; }
.blob { position: absolute; border-radius: 50%; opacity: 0.2; pointer-events: none; filter: blur(2px); }
.hcard-kicker { font-size: 0.68rem; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; color: #6B6B6B; margin-bottom: 0.2rem; }
.hc-dark .hcard-kicker { color: rgba(255,255,255,0.4); }
.hcard-val { font-family: 'DM Serif Display', serif; font-size: 1.5rem; line-height: 1.15; color: #1A1A1A; }
.hc-dark .hcard-val { color: #fff; }
.hcard-note { font-size: 0.75rem; color: #6B6B6B; margin-top: 0.2rem; }
.hc-dark .hcard-note { color: rgba(255,255,255,0.45); }

/* ─────────────────────────────────────────────────────────────
   LAYOUT HELPERS
───────────────────────────────────────────────────────────── */
.wrap { max-width: 1300px; margin: 0 auto; padding: 6rem 2.5rem; }
.sec-kicker {
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: #6B6B6B;
  margin-bottom: 0.5rem;
}
.sec-title {
  font-family: 'DM Serif Display', serif;
  font-size: clamp(1.8rem, 3vw, 2.8rem);
  line-height: 1.15;
  letter-spacing: -0.5px;
  margin-bottom: 2.5rem;
  color: #1A1A1A;
}

/* ─────────────────────────────────────────────────────────────
   SERVICES BENTO
───────────────────────────────────────────────────────────── */
.bento { display: grid; grid-template-columns: repeat(3, 1fr); grid-auto-rows: auto; gap: 1rem; }
.bc {
  border-radius: var(--r);
  overflow: hidden;
  position: relative;
  box-shadow: 0 4px 16px rgba(0,0,0,0.05), 0 12px 32px rgba(0,0,0,0.05), inset 0 1px 0 rgba(255,255,255,0.85);
  transition: transform 0.25s, box-shadow 0.25s;
}
.bc:hover { transform: translateY(-4px); box-shadow: 0 8px 24px rgba(0,0,0,0.08), 0 24px 48px rgba(0,0,0,0.07); }
.span2 { grid-column: span 2; }
.bc-img { width: 100%; height: 180px; object-fit: cover; display: block; }
.span2 .bc-img { height: 200px; }
.bc-body { padding: 1.4rem 1.6rem 1.6rem; }
.bc-teal   { background: linear-gradient(140deg, #e4f9f9, #f8fffe); }
.bc-orange { background: linear-gradient(140deg, #fff2e0, #fffcf8); }
.bc-pink   { background: linear-gradient(140deg, #fce4f0, #fff8fc); }
.bc-lime   { background: linear-gradient(140deg, #edf6d8, #f9fdf0); }
.bc-dark   { background: #1A1A1A; }
.bc-white  { background: #ffffff; }
.bc-tag {
  display: inline-block;
  padding: 0.25rem 0.7rem;
  border-radius: 100px;
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  margin-bottom: 0.7rem;
}
.tag-teal   { background: rgba(27,191,191,0.15);  color: #1BBFBF; }
.tag-orange { background: rgba(247,148,29,0.15);  color: #F7941D; }
.tag-pink   { background: rgba(233,30,140,0.15);  color: #E91E8C; }
.tag-lime   { background: rgba(141,198,63,0.18);  color: #5a8a1a; }
.tag-white  { background: rgba(255,255,255,0.15); color: #fff; }
.tag-muted  { background: rgba(0,0,0,0.06);       color: #6B6B6B; }
.bc-title { font-family: 'DM Serif Display', serif; font-size: 1.1rem; line-height: 1.3; margin-bottom: 0.45rem; color: #1A1A1A; }
.bc-dark .bc-title { color: #fff; }
.bc-desc { font-size: 0.83rem; color: #6B6B6B; line-height: 1.65; }
.bc-dark .bc-desc { color: rgba(255,255,255,0.55); }
.bc-num { font-family: 'DM Serif Display', serif; font-size: 4rem; line-height: 1; color: #1A1A1A; opacity: 0.06; position: absolute; bottom: 0.8rem; right: 1.2rem; }
.bc-dark .bc-num { color: #fff; }

/* ─────────────────────────────────────────────────────────────
   WHY SECTION
───────────────────────────────────────────────────────────── */
.why-wrap { background: #1A1A1A; }
.why-inner { max-width: 1300px; margin: 0 auto; padding: 6rem 2.5rem; display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center; }
.why-text .sec-kicker { color: rgba(255,255,255,0.35); }
.why-text .sec-title  { color: #fff; margin-bottom: 0; }
.why-text p { color: rgba(255,255,255,0.55); font-size: 0.95rem; line-height: 1.75; margin-top: 1rem; max-width: 360px; }
.why-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
.why-card { padding: 1.6rem; border-radius: 22px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.07); transition: background 0.2s, transform 0.2s; }
.why-card:hover { background: rgba(255,255,255,0.09); transform: translateY(-3px); }
.why-accent { width: 28px; height: 3px; border-radius: 3px; margin-bottom: 0.8rem; }
.why-card h3 { font-size: 0.92rem; font-weight: 600; color: #fff; margin-bottom: 0.35rem; }
.why-card p  { font-size: 0.8rem; color: rgba(255,255,255,0.45); line-height: 1.6; }

/* ─────────────────────────────────────────────────────────────
   PROCESS
───────────────────────────────────────────────────────────── */
.prow { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
.pstep { padding: 1.8rem; }
.pstep-bar { height: 3px; border-radius: 3px; margin-bottom: 1.2rem; }
.pstep-n { font-family: 'DM Serif Display', serif; font-size: 3rem; line-height: 1; opacity: 0.08; margin-bottom: 0.8rem; }
.pstep h3 { font-size: 0.92rem; font-weight: 600; margin-bottom: 0.4rem; color: #1A1A1A; }
.pstep p  { font-size: 0.82rem; color: #6B6B6B; line-height: 1.6; }

/* ─────────────────────────────────────────────────────────────
   TESTIMONIALS
───────────────────────────────────────────────────────────── */
.test-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
.tcard { padding: 2rem; transition: transform 0.2s, box-shadow 0.2s; }
.tcard:hover { transform: translateY(-4px); }
.tcard-stars { font-size: 0.85rem; letter-spacing: 3px; margin-bottom: 1rem; }
.tcard blockquote { font-size: 0.92rem; line-height: 1.75; font-style: italic; color: #1A1A1A; }
.tcard cite { display: block; margin-top: 1.2rem; font-size: 0.8rem; font-weight: 600; font-style: normal; }

/* ─────────────────────────────────────────────────────────────
   CONTACT
───────────────────────────────────────────────────────────── */
.contact-wrap { background: #ffffff; }
.contact-inner { max-width: 1300px; margin: 0 auto; padding: 6rem 2.5rem; display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: start; }
.contact-text .sec-title { margin-bottom: 1rem; }
.contact-text p { color: #6B6B6B; font-size: 0.95rem; line-height: 1.75; max-width: 340px; }
.cdetails { margin-top: 2rem; display: flex; flex-direction: column; gap: 0.8rem; }
.cdetail { display: flex; align-items: center; gap: 0.7rem; font-size: 0.88rem; font-weight: 500; color: #1A1A1A; }
.ci { width: 36px; height: 36px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1rem; }
.ci-t { background: rgba(27,191,191,0.1); }
.ci-o { background: rgba(247,148,29,0.1); }
.ci-p { background: rgba(233,30,140,0.1); }

/* Form */
.cform { background: #F4F2EE; border-radius: var(--r); padding: 2rem; box-shadow: 0 4px 24px rgba(0,0,0,0.05), inset 0 1px 0 rgba(255,255,255,0.8); }
.frow { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 0.75rem; }
.ff { display: flex; flex-direction: column; gap: 0.3rem; }
.ff label { font-size: 0.75rem; font-weight: 600; color: #6B6B6B; letter-spacing: 0.5px; }
.ff input,
.ff select,
.ff textarea {
  background: #ffffff;
  border: 1.5px solid rgba(0, 0, 0, 0.1);
  border-radius: 12px;
  padding: 0.7rem 0.9rem;
  font-size: 0.9rem;
  font-family: 'DM Sans', sans-serif;
  color: #1A1A1A;
  outline: none;
  transition: border-color 0.2s, box-shadow 0.2s;
}
.ff input::placeholder,
.ff textarea::placeholder { color: rgba(26,26,26,0.35); }
.ff input:focus,
.ff select:focus,
.ff textarea:focus { border-color: #1BBFBF; box-shadow: 0 0 0 3px rgba(27,191,191,0.1); }
.ff input.error,
.ff textarea.error { border-color: #E91E8C; box-shadow: 0 0 0 3px rgba(233,30,140,0.1); }
.ff textarea { resize: vertical; min-height: 90px; }
.fsub {
  width: 100%;
  margin-top: 0.75rem;
  padding: 0.85rem;
  border: none;
  border-radius: 100px;
  cursor: pointer;
  background: #1A1A1A;
  color: #ffffff;
  font-size: 0.95rem;
  font-weight: 600;
  font-family: 'DM Sans', sans-serif;
  box-shadow: 0 6px 20px rgba(0,0,0,0.18);
  transition: background 0.2s, transform 0.2s, opacity 0.2s;
}
.fsub:hover { background: #333; transform: translateY(-2px); }
.fsub:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }

.form-errors { background: rgba(233,30,140,0.07); border: 1px solid rgba(233,30,140,0.2); border-radius: 12px; padding: 0.8rem 1rem; margin-bottom: 1rem; }
.form-errors p { font-size: 0.8rem; color: #E91E8C; margin-bottom: 0.2rem; }
.form-errors p:last-child { margin-bottom: 0; }

.form-success { text-align: center; padding: 2rem 1rem; }
.success-icon { font-size: 2.5rem; margin-bottom: 0.5rem; }
.form-success h3 { font-family: 'DM Serif Display', serif; font-size: 1.5rem; margin-bottom: 0.5rem; color: #1A1A1A; }
.form-success p { color: #6B6B6B; font-size: 0.9rem; }

.form-alt-text { text-align: center; font-size: 0.8rem; color: #6B6B6B; margin-top: 0.75rem; }
.form-alt-text a { color: #1BBFBF; font-weight: 600; text-decoration: none; }
.form-alt-text a:hover { text-decoration: underline; }

/* ─────────────────────────────────────────────────────────────
   FOOTER
───────────────────────────────────────────────────────────── */
.site-footer { background: #111; color: rgba(255,255,255,0.6); }
.footer-inner { max-width: 1300px; margin: 0 auto; padding: 3.5rem 2.5rem 2rem; display: grid; grid-template-columns: 1.5fr 1fr; gap: 3rem; }
.footer-brand { display: flex; flex-direction: column; gap: 0.75rem; }
.footer-logo { font-size: 1.5rem; font-weight: 800; color: #fff; letter-spacing: -0.5px; }
.footer-logo em { font-style: normal; color: #1BBFBF; }
.footer-brand p { font-size: 0.88rem; line-height: 1.6; max-width: 280px; }
.footer-links { display: flex; gap: 3rem; }
.footer-col { display: flex; flex-direction: column; gap: 0.6rem; }
.footer-col h4 { font-size: 0.72rem; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; color: #fff; margin-bottom: 0.25rem; }
.footer-col a { font-size: 0.88rem; color: rgba(255,255,255,0.5); text-decoration: none; transition: color 0.2s; cursor: pointer; }
.footer-col a:hover { color: #1BBFBF; }
.footer-bottom { max-width: 1300px; margin: 0 auto; padding: 1.2rem 2.5rem; border-top: 1px solid rgba(255,255,255,0.07); display: flex; align-items: center; justify-content: space-between; font-size: 0.8rem; }
.footer-admin-link { color: rgba(255,255,255,0.2); text-decoration: none; font-size: 0.75rem; transition: color 0.2s; }
.footer-admin-link:hover { color: rgba(255,255,255,0.5); }

/* ─────────────────────────────────────────────────────────────
   FLOATING WHATSAPP
───────────────────────────────────────────────────────────── */
.wa-float {
  position: fixed;
  bottom: 1.8rem; right: 1.8rem;
  z-index: 999;
  width: 56px; height: 56px;
  border-radius: 50%;
  background: #25D366;
  color: #fff;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 4px 16px rgba(37,211,102,0.45);
  transition: transform 0.2s, box-shadow 0.2s;
  text-decoration: none;
}
.wa-float:hover { transform: translateY(-3px) scale(1.06); box-shadow: 0 8px 24px rgba(37,211,102,0.55); }

/* ─────────────────────────────────────────────────────────────
   SCROLL REVEAL
───────────────────────────────────────────────────────────── */
.reveal-item {
  opacity: 0;
  transform: translateY(28px);
  transition:
    opacity 0.55s ease calc(var(--delay, 0s)),
    transform 0.55s ease calc(var(--delay, 0s));
}
.reveal-section.is-visible .reveal-item {
  opacity: 1;
  transform: translateY(0);
}

/* ─────────────────────────────────────────────────────────────
   KEYFRAMES
───────────────────────────────────────────────────────────── */
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(20px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ─────────────────────────────────────────────────────────────
   WORKERS PAGE (public)
───────────────────────────────────────────────────────────── */
.workers-root {
  min-height: 100vh;
  background: #0f1117;
  font-family: 'DM Sans', sans-serif;
}

/* ─────────────────────────────────────────────────────────────
   RESPONSIVE
───────────────────────────────────────────────────────────── */
@media (max-width: 960px) {
  .hero-section { padding: 0 1.5rem; min-height: auto; }
  .hero { grid-template-columns: 1fr; padding-top: 6rem; padding-bottom: 3rem; gap: 2rem; }
  .hero-bento { display: none; }
  .bento { grid-template-columns: 1fr 1fr; }
  .span2 { grid-column: span 2; }
  .why-inner, .contact-inner { grid-template-columns: 1fr; gap: 2rem; }
  .prow { grid-template-columns: 1fr 1fr; }
  .test-grid { grid-template-columns: 1fr; }
  /* Public navbar: hide ul on mobile — but NOT admin nav (that's a div.nav-links, not ul) */
  nav > ul { display: none; }
  .footer-inner { grid-template-columns: 1fr; gap: 2rem; padding: 2.5rem 1.5rem 1.5rem; }
  .footer-links { gap: 2rem; }
}

@media (max-width: 600px) {
  .bento { grid-template-columns: 1fr; }
  .span2 { grid-column: span 1; }
  .frow { grid-template-columns: 1fr; }
  .prow { grid-template-columns: 1fr; }
  .wrap { padding: 4rem 1.5rem; }
  .wa-float { bottom: 1.2rem; right: 1.2rem; width: 50px; height: 50px; }
  .footer-bottom { padding: 1rem 1.5rem; flex-direction: column; gap: 0.5rem; text-align: center; }
  .contact-inner { padding: 3rem 1.5rem; }
}
