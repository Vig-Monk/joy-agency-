/* ─────────────────────────────────────────────────────────────
   JOY Recruitment Agency — Global Styles
───────────────────────────────────────────────────────────── */

/* ── Google Fonts ── */
@import url('https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600;700&display=swap');

/* ── CSS Custom Properties ── */
:root {
  --teal:   #1BBFBF;
  --orange: #F7941D;
  --pink:   #E91E8C;
  --lime:   #8DC63F;
  --bg:     #F4F2EE;
  --white:  #FFFFFF;
  --ink:    #1A1A1A;
  --muted:  #6B6B6B;
  --r:      28px;
}

/* ── Reset ── */
*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
html { scroll-behavior: smooth; }

/* ── Body: LOCK to light mode.
   The public site is light-only by design.
   Admin/workers pages use their own root classes for dark.
   color-scheme: light tells the browser to keep system UI
   (scrollbars, inputs, selects) in light mode on this page. ── */
body {
  font-family: 'DM Sans', sans-serif;
  background: #F4F2EE;
  color: #1A1A1A;
  overflow-x: hidden;
  color-scheme: light;
}

/* Override for admin/workers/detail/login pages which
   have their own full-dark root element */
.admin-root,
.workers-root,
.detail-root,
.login-root {
  color-scheme: dark;
  background: #0f1117;
  color: #f0f2f7;
}

/* ─────────────────────────────────────────────────────────────
   NAVBAR
───────────────────────────────────────────────────────────── */
nav {
  position: fixed;
  top: 0;
  width: 100%;
  z-index: 99;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.85rem 2.5rem;
  background: rgba(244, 242, 238, 0.92);
