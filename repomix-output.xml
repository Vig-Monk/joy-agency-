}
.bc:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 24px rgba(0,0,0,0.08), 0 24px 48px rgba(0,0,0,0.07);
}
.span2 { grid-column: span 2; }
.bc-img { width: 100%; height: 180px; object-fit: cover; display: block; }
