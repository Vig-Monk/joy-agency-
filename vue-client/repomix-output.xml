<script setup>
import { ref, onMounted, onUnmounted } from 'vue'

// Refs for parallax targets
const heroRef = ref(null)
const bentoRef = ref(null)
const card1Ref = ref(null)
const card2Ref = ref(null)
const card3Ref = ref(null)
const card4Ref = ref(null)
const card5Ref = ref(null)

// WhatsApp
const whatsappLink = `https://wa.me/703 935838?text=${encodeURIComponent("Hello! I'd like to enquire about your domestic staffing services.")}`

function scrollTo(id) {
  const el = document.getElementById(id)
  if (el) el.scrollIntoView({ behavior: 'smooth' })
}

// ─── Parallax on scroll ───────────────────────────────────────────────────────
// Cards stagger slightly at different rates — creates a subtle depth effect.
function applyParallax() {
  if (!heroRef.value) return
  const rect = heroRef.value.getBoundingClientRect()
  const progress = -rect.top // pixels scrolled past hero top

  // Bento grid moves at 0.08x scroll speed (slower than content → floats)
  if (bentoRef.value) {
    bentoRef.value.style.transform = `translateY(${progress * 0.08}px)`
  }
  // Individual cards get slight offsets for depth
  const offsets = [0.04, -0.04, 0.06, -0.03, 0.05]
  const refs = [card1Ref, card2Ref, card3Ref, card4Ref, card5Ref]
  refs.forEach((r, i) => {
    if (r.value) {
      r.value.style.transform = `translateY(${progress * offsets[i]}px)`
    }
  })
}

onMounted(() => window.addEventListener('scroll', applyParallax, { passive: true }))
onUnmounted(() => window.removeEventListener('scroll', applyParallax))
</script>
